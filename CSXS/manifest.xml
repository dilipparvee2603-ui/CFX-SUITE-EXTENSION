<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.cfx.suite" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="CFX Suite"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.cfx.suite.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2020 (17.0) through 2026+ -->
            <Host Name="AEFT" Version="[17.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.cfx.suite.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/main.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--disable-gpu</Parameter>
                        <Parameter>--disable-gpu-compositing</Parameter>
                        <Parameter>--disable-gpu-rasterization</Parameter>
                        <Parameter>--disable-accelerated-2d-canvas</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>CFX Suite</Menu>
                    <Geometry>
                        <Size>
                            <Width>380</Width>
                            <Height>720</Height>
                        </Size>
                        <MinSize>
                            <Width>280</Width>
                            <Height>350</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>1800</Width>
                            <Height>2400</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/assets/icons/icon-normal.png</Icon>
                        <Icon Type="RollOver">./client/assets/icons/icon-normal.png</Icon>
                        <Icon Type="Disabled">./client/assets/icons/icon-normal.png</Icon>
                        <Icon Type="DarkNormal">./client/assets/icons/icon-normal.png</Icon>
                        <Icon Type="DarkRollOver">./client/assets/icons/icon-normal.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
